# ─────────────────────────────────────────────────────────
# Fluent Core — environment configuration
# ─────────────────────────────────────────────────────────
#
# Users authenticate via OAuth in the Fluent Settings window.
# No API keys are stored here. The only values you need to fill
# in are the OAuth *client IDs* that identify your registered app.
#
# Register your OAuth clients once:
#   Anthropic → https://console.anthropic.com/settings/oauth-apps
#             Redirect URI: http://localhost:7432/auth/anthropic/callback
#
#   OpenAI    → https://platform.openai.com/settings/oauth
#             Redirect URI: http://localhost:7432/auth/openai/callback
#
#   Google    → https://console.cloud.google.com/ (OAuth 2.0 Client ID)
#             Redirect URI: http://localhost:7432/auth/gemini/callback
#
# After a user connects, their token is stored securely at
#   ~/.fluent/tokens.json  (chmod 600, readable only by the current user)

# ── OAuth client IDs ──────────────────────────────────────
ANTHROPIC_CLIENT_ID=
OPENAI_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ── Model selection (optional — defaults shown) ───────────
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# ── Server ────────────────────────────────────────────────
PORT=7432
MAX_INPUT_LENGTH=8000
